{
  "multipart": [
    { "apply": { "model": "crystalnexus:block/pipe_straight_core" } },
    { "when": { "north": true }, "apply": { "model": "crystalnexus:block/pipe_straight_north" } },
    { "when": { "south": true }, "apply": { "model": "crystalnexus:block/pipe_straight_south" } },
    { "when": { "east": true }, "apply": { "model": "crystalnexus:block/pipe_straight_east" } },
    { "when": { "west": true }, "apply": { "model": "crystalnexus:block/pipe_straight_west" } },
    { "when": { "up": true }, "apply": { "model": "crystalnexus:block/pipe_straight_up" } },
    { "when": { "down": true }, "apply": { "model": "crystalnexus:block/pipe_straight_down" } }
  ]
}
