    { "when": { "facing": "west", "blockstate": "2", "curve": "straight" }, "apply": { "model": "crystalnexus:block/meteorite_conveyer_belt_bottom", "y": 270 } },
    { "when": { "facing": "north", "curve": "left" }, "apply": { "model": "crystalnexus:block/meteorite_conveyer_belt_curve_left" } },
