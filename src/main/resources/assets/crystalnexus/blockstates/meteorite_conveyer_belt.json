    { "when": { "facing": "west", "blockstate": "0|1", "curve": "straight" }, "apply": { "model": "crystalnexus:block/meteorite_conveyer_belt", "y": 270 } },
    { "when": { "facing": "north", "blockstate": "2", "curve": "straight" }, "apply": { "model": "crystalnexus:block/meteorite_conveyer_belt_bottom" } },
    { "when": { "facing": "east", "blockstate": "2", "curve": "straight" }, "apply": { "model": "crystalnexus:block/meteorite_conveyer_belt_bottom", "y": 90 } },
